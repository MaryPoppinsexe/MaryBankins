### Auth Endpoints
### Variables are shared across requests via the http-client.env.json file

# ─── Register ────────────────────────────────────────────────────────────────

POST http://{{host}}/api/auth/register
Content-Type: application/json

{
  "ownerName": "johndoe",
  "password": "password123",
  "firstName": "John",
  "lastName": "Doe",
  "dateOfBirth": "1990-01-15",
  "nif": "123456789",
  "phoneNumber": "912345678",
  "email": "john.doe@example.com"
}

### ─── Login ─────────────────────────────────────────────────────────────────

# @name login
POST http://{{host}}/api/auth/login
Content-Type: application/json

{
  "ownerName": "johndoe",
  "password": "password123"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
  client.test("Login successful", function() {
    client.assert(response.status === 200, "Expected 200");
    client.assert(response.body.accessToken !== null, "Expected access token");
  });
%}

### ─── Login as Admin ─────────────────────────────────────────────────────────

# @name loginAdmin
POST http://{{host}}/api/auth/login
Content-Type: application/json

{
  "ownerName": "admin",
  "password": "admin123"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### ─── Refresh Token ──────────────────────────────────────────────────────────

POST http://{{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### ─── Logout ─────────────────────────────────────────────────────────────────

POST http://{{host}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
